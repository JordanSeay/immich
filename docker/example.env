# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
IMMICH_VERSION=v2

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=postgres

###################################################################################
# S3 Storage Configuration (Optional)
# Uncomment and configure these variables to use S3 instead of local storage
# See https://docs.immich.app/install/s3-storage for detailed setup instructions
###################################################################################

# Storage backend: 'local' (default) or 's3'
# IMMICH_STORAGE_BACKEND=s3

# S3 bucket name (required when using S3)
# IMMICH_S3_BUCKET=immich-media

# AWS region (required when using S3)
# IMMICH_S3_REGION=us-east-1

# Custom S3 endpoint (optional, for MinIO, Wasabi, Backblaze B2, LocalStack, etc.)
# IMMICH_S3_ENDPOINT=https://s3.us-east-1.wasabisys.com

# AWS credentials (optional, not needed if using IAM roles on AWS infrastructure)
# IMMICH_S3_ACCESS_KEY=your-access-key-id
# IMMICH_S3_SECRET_KEY=your-secret-access-key

# Use path-style URLs (required for MinIO and LocalStack, default: true)
# IMMICH_S3_FORCE_PATH_STYLE=true

# Key prefix for S3 objects (optional, useful for multi-tenant setups)
# IMMICH_STORAGE_PREFIX=

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
